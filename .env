# .env

# --- DATABASE CONFIGS ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=222819
USER_DB=user_db
CREDENTIAL_DB=credential_db
ORDER_DB=order_service_db
POST_DB=review_db

# --- STORAGE CONFIG ---
CONTAINER_UPLOAD_ROOT=/upload_data 

# --- SPRING VARIABLES ---
USER_DB_IP=user-db
USER_DB_PORT=5432
CREDENTIAL_DB_IP=credential-db
CREDENTIAL_DB_PORT=5432
POST_DB_IP=post-db
POST_DB_PORT=5432

# --- MESSAGE BROKER CONFIG ---
BROKER_HOST=rabbitmq
BROKER_PORT=5672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- JWT CONFIG ---
JWT_SECRET=super-secret-demo-key-change-me!

# --- DOMAIN ---
DOMAIN_URL=http://localhost

PRODUCT_DB=product_db
PRODUCT_DB_IP=product-db
PRODUCT_DB_PORT=5432

# --- NOTIFICATION SERVICE ---
NOTIFICATION_DB=notification_db
NOTIFICATION_DB_IP=notification-db
NOTIFICATION_DB_PORT=5432
